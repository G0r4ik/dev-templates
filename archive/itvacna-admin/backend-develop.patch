--- a/components/list/sql.js
+++ b/components/list/sql.js
@@ -122,6 +122,26 @@ class Queries {
   getSearchQueries() {
     return pQuery(`SELECT * FROM search_queries;`)
   }
+
+  //
+
+  addCategoryTool(name, id) {
+    return pQuery(
+      `INSERT INTO categories_tools(id_category, id_tool) VALUES($1, $2);`,
+      [name, id]
+    )
+  }
+
+  addCategory(name) {
+    return pQuery(`INSERT INTO categories(name_category) VALUES($1);`, [name])
+  }
+
+  addTool(name) {
+    return pQuery(
+      `INSERT INTO tools(name_tool) VALUES($1) RETURNING id_tool;`,
+      [name]
+    )
+  }
 }
 
 export default new Queries()
