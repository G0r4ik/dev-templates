{
  "extends": [
    "@commitlint/config-conventional"
  ],
  "rules": {
    "subject-case": [
      0
    ],
    "subject-full-stop": [
      2,
      "never",
      "."
    ],
    "subject-max-length": [
      2,
      "always",
      72
    ],
    "body-leading-blank": [
      2,
      "always"
    ],
    "body-max-line-length": [
      2,
      "always",
      80
    ]
  }
}
