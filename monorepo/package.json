{
  "name": "it-vacancy-trend",
  "version": "1.0.0",
  "description": "IT Vacancy Analytics - анализ и визуализация требований к технологиям в IT-вакансиях",
  "author": "G0r4ik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/G0r4ik/it-vacancy-trend.git"
  },
  "homepage": "https://itvacna.goraworks.com",
  "keywords": [
    "it",
    "vacancy",
    "analytics",
    "trends",
    "jobs",
    "statistics"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo dev",
    "dev:backend": "turbo --filter backend dev",
    "dev:frontend": "turbo --filter frontend dev",
    "dev:database": "turbo --filter database dev",
    "lint": "turbo lint",
    "test": "turbo test --log-prefix=none",
    "update:deps": "taze -w -r",
    "secrets:pull": "turbo secrets:pull",
    "deploy": "docker compose -f docker-compose.prod.yml up -d --build",
    "============================================": "============================================",
    "build": "turbo build",
    "setup": "pnpm install && pnpm secrets:pull && docker compose up postgres -d && pnpm --filter=db migrate && pnpm --filter=db seed",
    "lint:js": "cd apps/frontend && pnpm exec eslint --fix --max-warnings=0",
    "lint:css": "cd apps/frontend && pnpm exec stylelint --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/prompt-cli": "^20.1.0",
    "@eslint/js": "^9.38.0",
    "conventional-changelog-cli": "^5.0.0",
    "cross-env": "^10.1.0",
    "editorconfig-checker": "^6.1.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-turbo": "^2.5.8",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "sinon": "^21.0.0",
    "supertest": "^7.1.4",
    "taze": "^19.8.1",
    "turbo": "^2.5.8",
    "vitest": "^4.0.2"
  }
}
